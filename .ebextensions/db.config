commands:
  upgrade_postgres:
    command: |
      /usr/bin/yum -y install postgresql16

files:
  "/etc/profile.d/z_psql.sh":
    content: |
      export PGHOST="${DATABASE_HOST}"
      export PGPORT=5432
      export PGDATABASE=safecast
      export PGUSER=safecast

      cat > ~/.pgpass <<EOF
      ${DATABASE_HOST}:5432:safecast:safecast:${DATABASE_PASSWORD}
      EOF
      chmod 600 ~/.pgpass
